{
  "schemaVersion": 1,
  "id": "oppickaxe",
  "version": "${version}",
  "name": "Mods by Igor Pak",
  "description": "A collection of custom Minecraft mods by IgorPak.",
  "authors": ["IgorPak"],
  "license": "MIT",
  "environment": "*",
  "accessWidener": "oppickaxe.accesswidener",
